# Copy to .env (git-ignored) and fill in your own values. Never commit .env.

# AWS credentials: by default they come from ~/.aws (run `aws configure`); docker-compose mounts
# ~/.aws into the API container read-only. Uncomment these only if you prefer keys in .env
# (they then take precedence). On App Runner the instance role is used, never keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Shared dev resources; your data goes under DEV_PREFIX (p1, p2, p3, p4).
# Create/refresh them with: docker compose run --rm api python scripts/setup_aws.py
S3_BUCKET=firstcommit-stt-bakeoff-632127306260
DYNAMO_TABLE=expressive-captions-dev
DEV_PREFIX=p1

# TEMPORARY (services/api/app/aws_fallback.py): if this project's own AWS account cannot reach
# Bedrock/Transcribe yet, the API can borrow another account's keys for THOSE TWO SERVICES ONLY.
# S3 and DynamoDB always use your default credentials. Leave both unset if your own credentials
# already have Bedrock + Transcribe — it is a no-op then. Never commit real values.
# NOTE: this covers the API only. The voice worker's streaming Transcribe and the vision tool's
# Rekognition still use your default credentials (~/.aws), so those need access regardless.
# FALLBACK_AWS_ACCESS_KEY_ID=
# FALLBACK_AWS_SECRET_ACCESS_KEY=

# Bedrock model (cross-region inference profile available in ap-south-1)
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# LiveKit Cloud project (voice transport — mic capture + STT only, see
# services/voice-agent/README.md and root ai-agent-report.md). Used by
# services/api/app/agent/livekit_token.py to mint room-join tokens.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Language for AWS Transcribe STREAMING in the voice worker. No default: the worker
# refuses to guess. en-IN is what Indian-English Hinglish speakers actually get recognised as.
VOICE_STT_LANGUAGE=en-IN

# Optional tuning. Defaults shown.
# How many tool rounds one agent command may take. One sentence is often several intents.
# AGENT_MAX_TOOL_ITERATIONS=14
# Longest clip the pipeline will process, in seconds.
# MAX_CLIP_SECONDS=60
# Server-side audio transcriber for POST /agent/voice-command with raw audio. No provider is
# wired, so leave unset: the editor sends TEXT (from LiveKit or the browser), never audio.
# VOICE_TRANSCRIBER=

# Frontend origin(s) allowed to call the API (and to upload to S3), comma-separated
CORS_ORIGINS=http://localhost:5173

# Sarvam Saaras v3: Hinglish Roman text. Real secret; ask the lead. Optional: without it the
# pipeline falls back to Transcribe text romanised by Bedrock (worse WER, see audit 11 §2).
SARVAM_API_KEY=

# Host port for the API container (8000 is taken by another project on some machines)
API_PORT=8010


# Read by apps/web (Vite only exposes VITE_* vars)
VITE_API_URL=http://localhost:8010
# true makes /editor?demo=1 open the bundled 28s demo project with a real video, which is
# what the agent demo runs on. Set false when you are working with your own uploaded projects.
VITE_USE_FIXTURE=true
