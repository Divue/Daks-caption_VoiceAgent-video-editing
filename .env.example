# Copy to .env (git-ignored) and fill in your own values. Never commit .env.

# Your personal AWS access keys for the shared dev account
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Shared dev resources; your data goes under DEV_PREFIX (p1, p2, p3, p4)
S3_BUCKET=
DYNAMO_TABLE=
DEV_PREFIX=p1

# Bedrock model id available in AWS_REGION (check the Bedrock console, model access)
BEDROCK_MODEL_ID=

# LiveKit Cloud project (voice transport — mic capture + STT only, see
# services/voice-agent/README.md and root ai-agent-report.md). Used by
# services/api/app/agent/livekit_token.py to mint room-join tokens.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Frontend origin(s) allowed to call the API, comma-separated
CORS_ORIGINS=http://localhost:5173

# Read by apps/web (Vite only exposes VITE_* vars)
VITE_API_URL=http://localhost:8000
VITE_USE_FIXTURE=false
