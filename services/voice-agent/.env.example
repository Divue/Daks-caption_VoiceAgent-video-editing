# Copy to .env (git-ignored) and fill in your own values. Never commit .env.
#
# This is a SEPARATE process from services/api — it has its own env file
# rather than sharing the root .env.example, since it's a distinct deployable
# (see README.md). Some values below will be duplicates of your root .env in
# local dev; that's expected.

# LiveKit Cloud project this worker connects to (same project the frontend's
# token endpoint at services/api/app/agent/livekit_token.py issues tokens for)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AWS credentials/region for streaming Transcribe (the shared dev account's
# keys work here — same convention as services/api/.env.example)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Language code for AWS Transcribe STREAMING (StartStreamTranscription) — a
# DIFFERENT API from the batch job in services/api/app/pipeline/stt.py, with
# its own language support/quality profile. Do not assume hi-IN works as
# well here as it does for the batch pipeline until verified with a real
# spike (see the team's LiveKit integration plan, "Risks" #1). No default is
# set here on purpose — see stt_provider.get_stt_language().
VOICE_STT_LANGUAGE=
